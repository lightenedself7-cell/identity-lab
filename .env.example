# Copy to .env and fill in as you go. Never commit .env.

# Your Okta org, from the browser address bar of the admin console minus "-admin"
OKTA_ORG_URL=https://integrator-0000000.okta.com
# Default custom authorization server (leave as-is unless you created your own)
# OKTA_ISSUER=https://integrator-0000000.okta.com/oauth2/default

# Phase 2: OIDC web app
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Phase 3: SAML app metadata URL (SAML app > Sign On tab > Metadata URL)
SAML_IDP_METADATA_URL=

# Phase 4: SCIM. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCIM_BEARER_TOKEN=

# Phase 5: protected API
API_AUDIENCE=api://default
API_REQUIRED_SCOPE=reports.read

# Phase 6: access review script (Okta API token, Security > API > Tokens)
OKTA_API_TOKEN=

# Tunnel for SCIM: "quick" (no account, URL changes on restart) or "named" (stable hostname, needs TUNNEL_TOKEN)
COMPOSE_PROFILES=named
TUNNEL_TOKEN=

# Leave empty: auto-detects Codespaces, otherwise http://localhost:5000
BASE_URL=
FLASK_SECRET_KEY=change-me-to-a-random-string
